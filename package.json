{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:e2e": "ng serve --build-target=frontend:build:development --proxy-config proxy.conf.json",
    "start:prod": "ng serve --configuration=production",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:ssr": "ng build --configuration production",
    "serve:ssr": "node dist/frontend/server/server.mjs",
    "dev:ssr": "ng serve",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:ui": "npx playwright test --ui",
    "e2e:prod": "BASE_URL=https://your-production-url.com npx playwright test",
    "e2e:prod:headed": "BASE_URL=https://your-production-url.com npx playwright test --headed"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "21.2.10",
    "@angular/compiler": "21.2.10",
    "@angular/core": "21.2.10",
    "@angular/forms": "21.2.10",
    "@angular/platform-browser": "21.2.10",
    "@angular/platform-server": "21.2.10",
    "@angular/router": "21.2.10",
    "@angular/service-worker": "21.2.10",
    "@angular/ssr": "21.2.10",
    "@ng-select/ng-select": "^21.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "browser-image-compression": "^2.0.2",
    "express": "^5.1.0",
    "firebase": "^12.14.0",
    "ngx-image-cropper": "^9.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.10",
    "@angular/build": "21.2.10",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.10",
    "@angular/platform-browser-dynamic": "21.2.10",
    "@playwright/test": "^1.58.2",
    "@types/browser-image-compression": "^1.0.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^20.19.39",
    "jasmine-core": "^6.0.1",
    "jsdom": "^27.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~5.9.2",
    "zone.js": "^0.16.0"
  }
}
